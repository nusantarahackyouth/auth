---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";
import { inputGroupControlClasses } from "./controlClasses";

interface Props extends HTMLAttributes<"textarea"> {
    class?: string;
}

const { class: className = "", ...rest } = Astro.props as Props;
---

<textarea
    data-slot="input-group-control"
    class={cn(inputGroupControlClasses, "h-auto resize-none py-2", className)}
    {...rest}
></textarea>
