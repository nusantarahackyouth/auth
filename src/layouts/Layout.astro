---
import CustomClientRouter from "@/components/core/CustomClientRouter.astro";
import TopProgress from "@/components/core/TopProgress.astro";
import TopToast from "@/components/core/TopToast.astro";
import "@/styles/globals.css";

import { consumeToast } from "@/lib/utils/toast";

interface Props {
    title?: string;
    handleToast?: boolean;
    pageTransition?: "none" | "fade";
}
const {
    title,
    handleToast = true,
    pageTransition = "none",
} = Astro.props;

const toast = handleToast ? consumeToast(Astro.cookies) : undefined;

---

<html lang="en" transition:animate={pageTransition}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>{title ? `${title} - NHY Auth` : "NHY Auth"}</title>

		<script>
		    const storedTheme = localStorage.getItem("@nhy/theme");
            const theme =
                storedTheme === "light" || storedTheme === "dark"
                    ? storedTheme
                    : matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light";

            document.documentElement.classList.toggle("dark", theme === "dark");
		</script>

		<CustomClientRouter />
	</head>
	<body>
            <TopProgress />
            {toast && <TopToast toast={toast} />}
			<slot />
	</body>
</html>
