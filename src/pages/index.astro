---
import Layout from "@/layouts/Layout.astro";
import LogoutModal from "@/components/modals/LogoutModal.astro";
import { withAuth } from "@/lib/auth";

export const prerender = false;

const authSession = await withAuth((auth) =>
    auth.api.getSession({
        headers: Astro.request.headers,
    }),
);

if (!authSession) {
    return Astro.redirect("/login");
}

const { user } = authSession;

---

<Layout title="Home">
    <p>You logged in! as {user.name} btw.</p>
    <LogoutModal>
        <a class="font-semibold underline">Logout?</a>
    </LogoutModal>
</Layout>
